+	const struct font_desc *font_cjk = find_font(fontname);
+	unsigned char *buf;
+
+	if (!font_cjk || !font_cjk->data)
+		return;
+
+	par->rotated.fontdata_utf = font_cjk->data;
+	buf = font_data_rotate(font_cjk->data,
