+			       font_cjk->charcount,
+			       par->rotated.buf_rotate,
+			       par->rotated.buf_utf,
+			       &par->rotated.bufsize_utf);
+	if (!IS_ERR(buf))
+		par->rotated.buf_utf = buf;
+}
